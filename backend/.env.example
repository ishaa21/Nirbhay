# ==============================================================================
# Nirbhay Women Safety Application - Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
BACKEND_BASE_URL=https://nirbhay-9d5i.onrender.com

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
# Alternatively, granular database configuration:
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=safety_app
# DB_PASSWORD=your_postgres_password
# DB_PORT=5432

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# ==============================================================================
# SMS dispatch strategy
# DEVICE (default): SOS SMS is sent from the user's Android phone via SIM; backend only logs results.
# GATEWAY: Legacy sms-gate.app / Twilio path (set explicitly only if needed).
# ==============================================================================
SMS_DISPATCH_MODE=DEVICE

# ==============================================================================
# Android SMS Gateway Configuration (https://sms-gate.app/)
# Use your Android phone and SIM card as a free SMS Gateway
# ==============================================================================

# Credentials generated in the Android SMS Gateway App (Settings -> API/Credentials)
SMS_GATEWAY_LOGIN=your_sms_gateway_login
SMS_GATEWAY_PASSWORD=your_sms_gateway_password

# Gateway API Endpoint (defaults to https://api.sms-gate.app/3rdparty/v1/messages)
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/messages

# Optional: Specific Device ID (if multiple devices are paired to your account)
# SMS_GATEWAY_DEVICE_ID=your_device_id_here

# Optional: Preferred SIM card slot for dual-SIM phones (1 or 2)
# SMS_GATEWAY_SIM_NUMBER=1

# Optional: Secret used to verify incoming delivery webhooks (X-Signature HMAC-SHA256)
# SMS_GATEWAY_WEBHOOK_SECRET=your_webhook_secret_key

# ==============================================================================
# Safe Test Mode (Optional)
# Diverts all SOS alert messages to a safe phone number during testing
# so real emergency contacts are not alarmed while setting up
# ==============================================================================
SMS_TEST_MODE=false
SMS_TEST_PHONE_NUMBER=+919876543210

# ==============================================================================
# Legacy Twilio Configuration (Optional Fallback)
# ==============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ==============================================================================
# Nearby Safety Services Configuration (OpenStreetMap Overpass)
# Zero external API key or billing required.
# ==============================================================================
# Optional custom Overpass API interpreter URL (defaults to https://overpass-api.de/api/interpreter)
# OVERPASS_URL=https://overpass-api.de/api/interpreter

